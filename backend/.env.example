# Backend configuration — copy this file to backend/.env and fill it in:
#   cp backend/.env.example backend/.env

# Runtime
NODE_ENV=development
PORT=8888

# Auth — REQUIRED in production. Generate with:  openssl rand -hex 32
#
# Leave blank in development to use a stable built-in dev secret.
# IMPORTANT: every backend that issues or verifies tokens must use the SAME
# value. If they differ, a token minted by one is rejected by the other with
# "Token is invalid or expired". Changing this value also logs out every
# existing session, because all previously issued tokens stop verifying.
JWT_SECRET=

# Database (SQLite — used by Prisma)
DATABASE_URL="file:./dev.db"

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
