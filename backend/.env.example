# Backend configuration — copy this file to backend/.env and fill it in:
#   cp backend/.env.example backend/.env

# Runtime
NODE_ENV=development
PORT=8888

# Auth — REQUIRED in production. Generate with:  openssl rand -hex 32
JWT_SECRET=

# Database (SQLite — used by Prisma)
DATABASE_URL="file:./dev.db"

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
