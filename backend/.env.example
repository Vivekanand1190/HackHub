# Backend Configuration Environment Variables

PORT=8888
JWT_SECRET=supersecret-hackhub-jwt-token-key-2026

# Database Connection (PostgreSQL)
# When running with docker-compose:
DATABASE_URL=postgresql://postgres:password@localhost:5432/hackhub?schema=public

# Optional: Cloudinary Storage Integration (Mocked if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Gemini API Key for actual AI Copilot analysis (Mocked if empty)
GEMINI_API_KEY=
