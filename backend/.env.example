# Backend configuration — copy this file to backend/.env and fill it in:
#   cp backend/.env.example backend/.env

# Runtime
NODE_ENV=development
PORT=8888

# Auth — REQUIRED in production. Generate each with:  openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# Database (SQLite — used by Prisma)
DATABASE_URL="file:./dev.db"

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# Google OAuth (optional — omit to disable the "Sign in with Google" button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:8888/api/auth/google/callback"

# Hugging Face Inference API (optional — the AI Copilot falls back to a
# built-in offline analysis when this is empty)
HUGGINGFACE_API_KEY=
