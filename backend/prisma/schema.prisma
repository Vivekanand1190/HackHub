datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String?       // Null for OAuth-only users
  googleId     String?       @unique
  avatar       String?       // Google profile picture URL
  name         String
  role         String        @default("Developer") // Developer, Designer, Presenter, Leader, Mentor
  xp           Int           @default(0)
  badges       String        @default("[]") // Array of earned badge names (JSON string)
  roleBadge    String        @default("Contributor")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  teams        Team[]        @relation("TeamMembers")
  ledTeams     Team[]        @relation("TeamLeader")
  tasks        Task[]
  messages     Message[]
  snippets     CodeSnippet[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  organizedEvents Event[]       @relation("EventOrganizer")
  pollVotes    PollVote[]
  pollsCreated Poll[]        @relation("UserCreatedPolls")
}

model Team {
  id             String        @id @default(uuid())
  name           String
  joinCode       String        @unique
  leaderId       String
  leader         User          @relation("TeamLeader", fields: [leaderId], references: [id])
  members        User[]        @relation("TeamMembers")
  eventId        String?
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tasks          Task[]
  messages       Message[]
  snippets       CodeSnippet[]
  documents      Document[]
  polls          Poll[]
  whiteboardData  String        @default("[]") // Array of drawing actions/paths (JSON string)
  copilotState    String        @default("{}") // Stores the latest AI Copilot recommendations and score (JSON string)
  milestones      String        @default("[]") // Project milestones [{ id, title, done }] (JSON string)
  githubRepo      String        @default("") // GitHub repository integration
  unlockedAvatars String        @default("[]") // Unlocked rewards shop items (JSON string)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String    @default("")
  column      String    @default("todo") // todo, inprogress, done
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deadline    DateTime?
  timeSpent   Int       @default(0) // time spent in seconds
  checklist   String    @default("[]") // Checklist items [{ id, text, done }] (JSON string)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Message {
  id         String    @id @default(uuid())
  text       String
  system     Boolean   @default(false)
  channel    String    @default("general")
  parentId   String?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attachment String?   // { filename, url, size, mimetype } (JSON string)
  reactions  String    @default("{}") // JSON map: { "👍": ["User1", "User2"] }
  editedAt   DateTime?
  timestamp  DateTime  @default(now())
}

model CodeSnippet {
  id        String   @id @default(uuid())
  title     String
  code      String
  language  String   @default("javascript")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String   @default("")
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // mention, task_assignment, deadline, judge_score, huddle_invite, announcement
  actorName String?
  title     String
  body      String
  targetUrl String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  inApp          Boolean @default(true)
  email          Boolean @default(false)
}

model Event {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String         @default("")
  banner      String?
  startDate   DateTime
  endDate     DateTime
  status      String         @default("draft") // draft | live | ended
  visibility  String         @default("public") // public | private
  organizerId String
  organizer   User           @relation("EventOrganizer", fields: [organizerId], references: [id])
  tracks      Track[]
  prizes      Prize[]
  sponsors    Sponsor[]
  schedule    ScheduleItem[]
  teams       Team[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Track {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  description     String   @default("")
  judgingCriteria String   @default("[]") // JSON string [{ name, weight }]
  prizes          Prize[]
  createdAt       DateTime @default(now())
}

model Sponsor {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  logo      String?
  url       String?
  tier      String   @default("silver") // title | gold | silver
  prizes    Prize[]
  createdAt DateTime @default(now())
}

model Prize {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trackId     String?
  track       Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)
  sponsorId   String?
  sponsor     Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  title       String
  description String   @default("")
  value       String   @default("")
  createdAt   DateTime @default(now())
}

model ScheduleItem {
  id             String   @id @default(uuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title          String
  type           String   @default("workshop") // workshop | talk | ceremony | deadline
  startTime      DateTime
  endTime        DateTime
  locationOrLink String   @default("")
  createdAt      DateTime @default(now())
}

model Poll {
  id        String     @id @default(uuid())
  teamId    String
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  question  String
  options   String     // JSON array of strings e.g. ["Option A", "Option B"]
  closed    Boolean    @default(false)
  createdBy String
  creator   User       @relation("UserCreatedPolls", fields: [createdBy], references: [id], onDelete: Cascade)
  votes     PollVote[]
  createdAt DateTime   @default(now())
}

model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIdx Int
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
}


